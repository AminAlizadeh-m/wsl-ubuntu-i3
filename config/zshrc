# zsh config for wsl-ubuntu-i3, installed as ~/.zshrc by setup-zsh-dark.sh.
# Oh My Zsh with the robbyrussell theme, and the git, syntax-highlighting
# and autosuggestions plugins. Edit freely, but re-running setup-zsh-dark.sh
# overwrites ~/.zshrc with this file (your own original is kept the first
# time as ~/.zshrc.pre-zsh-dark).

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Theme. See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="robbyrussell"

# Plugins: standard ones are in $ZSH/plugins/, the two extra ones are
# cloned into $ZSH/custom/plugins/ by setup-zsh-dark.sh.
plugins=(git zsh-syntax-highlighting zsh-autosuggestions)

source $ZSH/oh-my-zsh.sh

# User configuration

export PATH="$HOME/.local/bin:$PATH"

# Node version manager (only if installed)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Go
export GOPATH="$HOME/go"
export PATH="$PATH:$GOPATH/bin"
